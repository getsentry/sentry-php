includes:
    - phpstan-baseline.neon
    - phpstan-baseline-deprecations.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    tipsOfTheDay: false
    treatPhpDocTypesAsCertain: false
    level: 9
    paths:
        - src
    excludePaths:
        - tests/resources
        - tests/Fixtures
    dynamicConstantNames:
        - Monolog\Logger::API
    bootstrapFiles:
        - stubs/autoload.php
